{
  "manifest_version": 3,
  "name": "Claude Chat Sync",
  "version": "6.3.7",
  "description": "Track and sync visible Claude.ai chats across your Chrome profiles.",
  "permissions": ["storage", "unlimitedStorage", "cookies", "declarativeNetRequest"],
  "host_permissions": [
    "https://claude.ai/*",
    "https://anthropic.com/*",
    "https://auth.anthropic.com/*",
    "https://accounts.google.com/*",
    "https://generativelanguage.googleapis.com/*"
  ],
  "background": {
    "service_worker": "background/background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://claude.ai/*"],
      "js": ["shared/dev-mode.js", "shared/diag-logger.js", "shared/shared.js", "dist/shared/search-storage.js", "dist/shared/embedding-api.js", "dist/content/search-indexer.js", "content/content-script.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://accounts.google.com/o/oauth2/*", "https://accounts.google.com/signin/*"],
      "js": ["shared/google-account-helper.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}

